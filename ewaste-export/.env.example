# E-Waste Submission Portal — environment variables
# NO Supabase required. Files live on the server filesystem, metadata in SQLite.
# Copy this file to .env and fill in the values.

# SQLite database file location.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Used to sign the auth JWT. Generate a strong value with:
#   openssl rand -base64 32
# Leave blank in dev — a fallback (insecure) value is used automatically.
NEXTAUTH_SECRET=

# Owner account credentials. On first request to /api/config, if no owner
# exists in the DB, one is auto-created with these credentials. NEVER
# exposed to the browser (only NEXT_PUBLIC_* vars are public).
OWNER_EMAIL=riya.vartha18@gmail.com
OWNER_PASSWORD=Yash@22

# Where uploaded files live. Flat layout — files saved as <fileName>
# directly under this directory. Defaults to ./upload.
STORAGE_DIR=/home/z/my-project/upload
